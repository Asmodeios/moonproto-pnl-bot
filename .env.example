# Token from @BotFather.
BOT_TOKEN=
# Optional: your Telegram user id, to own the bot without claiming it from the
# chat. Left empty, the log prints a one-time claim link on start.
OWNER_ID=
# Where cores.json and the report replicas live.
DATA_DIR=data
# The cores' clock against UTC, in minutes. MoonBot writes report dates in the
# core's own local time; leave 0 for cores running on UTC.
REPORT_UTC_OFFSET_MINUTES=0
# RUST_LOG=info,moonproto=warn
